{
  "name": "@hyprsh/design",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "hyprsh design system: tokens, brand and React components. Published as a Design System artifact and installable as a package.",
  "license": "MIT",
  "repository": "github:hyprsh/design",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./icons": { "types": "./dist/icons.d.ts", "import": "./dist/icons.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./brand/*": "./dist/brand/*",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["*.css", "./dist/icons.js"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/package.mjs",
    "test": "node --test",
    "check": "node scripts/build.mjs --check",
    "prepare": "node scripts/package.mjs",
    "dev": "node scripts/dev.mjs",
    "shots": "node scripts/shot.mjs",
    "icons": "node scripts/icons.mjs",
    "tokens:css": "node scripts/tokens-css.mjs",
    "site": "node scripts/site.mjs"
  },
  "engines": { "node": ">=20" }
}
